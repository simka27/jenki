pipeline {
    agent any

    tools {
        // Подключаем .NET SDK, настроенный в инструментах Jenkins
        dotnetsdk 'dotnet8'
    }

    stages {
        stage('Checkout') {
            steps {
                // Очистка и получение актуального кода из репозитория
                cleanWs()
                checkout scm
            }
        }

        stage('Restore Dependencies') {
            steps {
                echo 'Restoring NuGet packages...'
                sh 'dotnet restore'
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building the .NET Web Application...'
                sh 'dotnet build --configuration Release --no-restore'
            }
        }

        stage('Run Automated Tests') {
            steps {
                echo 'Running xUnit Tests...'
                // Запуск тестов с генерацией логов сборки
                sh 'dotnet test --configuration Release --no-build --logger:"trx;LogFileName=test_results.trx"'
            }
            post {
                always {
                    // Публикация результатов тестов в интерфейс Jenkins
                    mstest testResultsFile: '**/test_results.trx', keepLongStdio: true
                }
            }
        }

        stage('Publish & Artifact') {
            steps {
                echo 'Publishing application artifacts...'
                sh 'dotnet publish MyWebPageApp/MyWebPageApp.csproj --configuration Release --output ./publish'
                // Архивируем собранный артефакт веб-страницы
                archiveArtifacts artifacts: 'publish/**/*', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline finished successfully! Application is ready for deployment.'
        }
        failure {
            echo 'Pipeline failed. Check test results or build logs.'
        }
    }
}